{
  "description": "Announces open heads at session start, reloads the interview after a compaction, renders the tree after a `hydra` command, and refuses to end a turn while heads are open.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "hydra hook session-start 2>/dev/null || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "hydra hook post-tool-use 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "hydra hook stop 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
